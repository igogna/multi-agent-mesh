# Template for .env, used only by the legacy `python -m adapters.cli_adapter.run`
# / `python -m adapters.cli_adapter.check_pr` entry points (kept temporarily for
# comparing old vs. new behavior). New usage should run `agentdev init` in your
# project instead, which writes .agentdev.toml + ~/.config/agentdev/config.toml.

# --- GitHub (needed starting Phase 3) ---
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BASE_BRANCH=

# --- LLM (needed starting Phase 2) ---
ANTHROPIC_API_KEY=

# --- LangGraph adapter only (Phase 6+, not needed before then) ---
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=
